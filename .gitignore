# ─── Secretos ────────────────────────────────────────────────────────────────
# Solo el .env real queda fuera. .env.example y .env.test SI se versionan:
# el primero es la plantilla que necesita quien clone el repo y el segundo es
# la configuracion que hace correr la suite de pruebas. Ninguno lleva secretos
# reales.
backend/.env

# ─── Dependencias y artefactos de build ──────────────────────────────────────
node_modules/
backend/dist/
backend/coverage/

# ─── Python (ia-engine) ──────────────────────────────────────────────────────
ia-engine/venv/
__pycache__/
*.py[cod]

# Modelos YOLO: se ignoran salvo el que usa el compose (sheep_detection.pt,
# ~5 MB). El de respaldo (yolo26n.pt) se copia a mano.
ia-engine/models/*.pt
!ia-engine/models/sheep_detection.pt

# Frames de inspección generados por ia-engine/scripts/diagnostico_conteo.py
ia-engine/scripts/salida_diagnostico/

# ─── Informes en PDF ─────────────────────────────────────────────────────────
# Versiones compiladas del informe y de otros equipos: pesan varios MB, cambian
# en cada compilación y no son código.
docs/*.pdf

# ─── Sistema operativo / editores ────────────────────────────────────────────
.DS_Store
Thumbs.db
