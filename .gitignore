# ─── Secretos ────────────────────────────────────────────────────────────────
# Solo el .env real queda fuera. .env.example y .env.test SI se versionan:
# el primero es la plantilla que necesita quien clone el repo y el segundo es
# la configuracion que hace correr la suite de pruebas. Ninguno lleva secretos
# reales.
backend/.env

# ─── Dependencias y artefactos de build ──────────────────────────────────────
node_modules/
backend/dist/
backend/coverage/

# ─── Python (ia-engine) ──────────────────────────────────────────────────────
ia-engine/venv/
__pycache__/
*.py[cod]

# Modelos YOLO: se ignoran salvo el que usa el compose (sheep_detection.onnx / .pt).
# El de respaldo (yolo26n.pt) se copia a mano.
ia-engine/models/*.pt
!ia-engine/models/sheep_detection.pt
ia-engine/models/*.onnx
!ia-engine/models/sheep_detection.onnx

# Scripts y salidas de pruebas locales del motor de IA.
ia-engine/scripts/
ia-engine/resultados_inferencia/

# ─── Documentación privada de desarrollo ─────────────────────────────────────
docs/

# ─── Sistema operativo / editores ────────────────────────────────────────────
.DS_Store
Thumbs.db
