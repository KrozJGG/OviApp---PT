NODE_ENV=test
PORT=3100
DATABASE_URL="postgresql://oviapp:oviapp@localhost:5434/oviapp_test?schema=public"
JWT_SECRET="secreto-solo-para-tests-de-al-menos-32-caracteres-largo"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DIAS=30
BCRYPT_ROUNDS=4
CORS_ORIGINS=*
