# video falla al instante en vez de esperar una resolucion de DNS que no existe.
MEDIAMTX_URL_INTERNO="http://127.0.0.1:9"
LOG_LEVEL=silent
PUSH_HABILITADO=false
CRON_HABILITADO=false
